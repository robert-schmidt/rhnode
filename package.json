{
  "name": "rhnode",
  "private": true,
  "type": "module",
  "description": "Robinhood Chain (4663) node, indexer and API.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "up": "docker compose -f compose.yaml -f compose.dev.yaml up -d clickhouse redis",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "ingest": "node --env-file-if-exists=.env src/ingest/main.ts",
    "typecheck": "tsc",
    "selftest": "node --env-file-if-exists=.env --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run selftest"
  },
  "dependencies": {
    "@clickhouse/client": "^1.24.1",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
