# Copy to .env (never commit .env: it may hold keyed URLs and passwords).
PROFILE=lite
CLICKHOUSE_USER=rhnode
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DB=rhnode
# Host-side tools (tests, scripts); the compose services override this with http://clickhouse:8123.
CLICKHOUSE_URL=http://127.0.0.1:8123

# Every block at the tip from free endpoints. Measured 2026-10-29: ~7.5 GB of ClickHouse disk per day of raw data,
# so 14 days ≈ 100 GB plus the forever tables. Lower RAW_TTL_DAYS on a small disk (it is baked into the tables at
# migration time; change it later with ALTER TABLE … MODIFY TTL).
INGEST_SCOPE=all
RAW_TTL_DAYS=14

# The API's loopback port (from M3). Put a reverse proxy in front of it.
API_PORT=8080

# UPSTREAM_HTTP=url|rps,url|rps   default: five keyless public endpoints (src/config.ts)
# LOOKUP_HTTP=url|rps             default: Tenderly's keyless gateway, used only for v4 pool lookups
