# Copy to .env (never commit .env: it may hold keyed URLs and passwords).
PROFILE=lite
CLICKHOUSE_USER=rhnode
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DB=rhnode
# Host-side tools (tests, scripts); the compose services override this with http://clickhouse:8123.
CLICKHOUSE_URL=http://127.0.0.1:8123

# Every block at the tip from free endpoints. Measured 2026-10-29: ~7.5 GB of ClickHouse disk per day of raw data,
# so 14 days ≈ 100 GB plus the forever tables. Lower RAW_TTL_DAYS on a small disk (it is baked into the tables at
# migration time; change it later with ALTER TABLE … MODIFY TTL).
INGEST_SCOPE=all
RAW_TTL_DAYS=14

# Redis carries the live block stream to the API; required.
REDIS_PASSWORD=change-me-to-a-long-random-password
# A separate API box on the LAN: publish ClickHouse/Redis/Nitro on 0.0.0.0 and let only that box in (ops/firewall.sh).
# NODE_BIND=0.0.0.0
# API_HOST=192.168.1.10
# Required. name:key pairs; clients send the key as x-api-key, ?apikey=, or /rpc/<key>, /ws/<key>.

# UPSTREAM_HTTP=url|rps,url|rps   default: five keyless public endpoints (src/config.ts)
# LOOKUP_HTTP=url|rps             default: Tenderly's keyless gateway, used only for v4 pool lookups

# ---- full profile: own Nitro node (README "Run a node") ----------------------
# COMPOSE_PROFILES=node                 # makes `docker compose up -d` include nitro + l1proxy
# L1_HTTP=https://eth.drpc.org|20       # url|rps,… for Nitro's L1 reads, first one up wins; a keyed URL is fine here
# L1_BEACON=https://ethereum-beacon-api.publicnode.com
# NITRO_MEM=8g  NITRO_GOMEMLIMIT=5000MiB  NITRO_DB_CACHE=768  NITRO_TRIE_CACHE=384
# NITRO_SNAPSHOT_CACHE=384   MB of flat-state cache
# NITRO_GOGC=100              300 cuts Nitro's GC CPU (its live heap is ~0.5 GB); GOMEMLIMIT still caps it
# NITRO_LOG_INDEX=--execution.rpc.log-no-history   while catching up; --execution.rpc.log-history=0 = whole chain

# ---- ops/heal.sh (self-heal timer) ---------------------------------------------
# DATA_MOUNT=/mnt/nvme                  # mounted again if it wasn't at boot (USB disks enumerate late)

# History walk (src/promoter/walk.ts, needs --profile node): go-live back to genesis on our own node, once it's synced.
# WALK=1
# WALK_DUTY=0.5   share of the time it works; it also waits whenever ingest trails the node by more than 50 blocks
